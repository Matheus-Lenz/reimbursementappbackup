        <name>Date validation Max Date</name>
        <order/>
        <published_ref/>
        <script><![CDATA[function onChange(control, oldValue, newValue, isLoading) {
    if (isLoading || newValue == '') {
        return;
    }

    var spendingDate = new Date(newValue);
    var today = new Date();

    today.setHours(0, 0, 0, 0);
    spendingDate.setHours(0, 0, 0, 0);

    if (spendingDate > today) {
        g_form.showFieldMsg('spending_date', 'The date cannot be set in the future.', 'error');
    } else {
        g_form.hideFieldMsg('spending_date', true);
    }
}]]></script>
